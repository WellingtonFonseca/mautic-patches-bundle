{#
  Body of the details modal of the segment list: the tabs of the segment page. Core's shared modal is narrow by default, so
  only a modal holding this body is widened (contacts_modal_width.html.twig, shared with the campaign node modals). The Contacts pane has the id and data-target-url of the page's one
  (core's own loader and the table's pagination use that id); it and the campaign shares are filled when their tab is first
  shown (SegmentListClickSubscriber). The buttons are a `.bottom-form-buttons` block, which core copies into the modal's
  footer (1a.content.js): Edit (btn-primary, only for who may edit), Details (the segment's page, btn-secondary) and Close (btn-tertiary btn-cancel, the transparent one). Only one .btn-primary: core's CSS draws a second one, and a btn-secondary after two, as outlined by position, so keep a single primary.
#}
{{ include('@MauticPatches/Contact/contacts_modal_width.html.twig', {'modalClass': 'mautic-patches-segment-details'}) }}
<div class="mautic-patches-segment-details" data-segment-id="{{ list.id }}">
    <ul class="nav nav-tabs nav-tabs-contained" role="tablist">
        <li class="active"><a href="#patches-segment-details" role="tab" data-toggle="tab">{{ 'mautic.core.details'|trans }}</a></li>
        <li><a href="#patches-segment-filters" role="tab" data-toggle="tab">{{ 'mautic.core.filters'|trans }}</a></li>
        <li><a href="#contacts-container" role="tab" data-toggle="tab" data-patches-load="contacts">{{ 'mautic.lead.leads'|trans }}</a></li>
        <li><a href="#patches-segment-campaigns" role="tab" data-toggle="tab" data-patches-load="shares">{{ 'mautic.lead.campaign.share'|trans }}</a></li>
    </ul>

    <div class="tab-content pa-md">
        <div class="tab-pane fade in active bdr-w-0" id="patches-segment-details">
            {% if list.description %}
                <p>{{ list.description|purify }}</p>
            {% endif %}
            <div class="panel shd-none mb-0">
                <table class="table table-hover mb-0">
                    <tbody>
                    {{ include('@MauticCore/Helper/details.html.twig', {'entity': list}) }}
                    <tr>
                        <td width="20%"><span class="fw-b textTitle">{{ 'mautic.lead.leads'|trans }}</span></td>
                        <td>{{ segmentCount }}</td>
                    </tr>
                    {% if list.lastBuiltTime %}
                    <tr>
                        <td width="20%"><span class="fw-b textTitle">{{ 'mautic.lead.list.last_built_time'|trans }}</span></td>
                        <td>{{ 'mautic.core.date.second'|trans({'%count%': list.lastBuiltTime}) }} ({{ dateToFull(list.lastBuiltDate) }})</td>
                    </tr>
                    {% endif %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade bdr-w-0" id="patches-segment-filters">
            {{ include('@MauticPatches/Segment/filters.html.twig', {'rows': rows}) }}
        </div>

        <div class="tab-pane fade bdr-w-0 page-list" id="contacts-container"
             data-target-url="{{ path('mautic_segment_contacts', {'objectId': list.id, 'page': 1}) }}">
            <div class="spinner"><i class="ri-loader-3-line ri-spin"></i></div>
        </div>

        <div class="tab-pane fade bdr-w-0" id="patches-segment-campaigns">
            <table class="table table-hover mb-0" id="patches-campaign-share-table">
                <thead>
                <tr>
                    <th>{{ 'mautic.campaign.campaign'|trans }}</th>
                    <th>{{ 'mautic.lead.share'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for stat in campaignStats %}
                    <tr>
                        <td>{{ stat.name }}</td>
                        <td width="20%">
                            <span class="patches-campaign-share-stat" data-value="{{ stat.id }}" id="patches-campaign-share-stat-{{ stat.id }}">{{ stat.share }}</span> %
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="bottom-form-buttons">
        {% if canEdit %}
        <button type="button" id="patches-segment-details-edit" class="btn btn-primary" onclick="mQuery('#MauticSharedModal').modal('hide'); Mautic.loadContent('{{ path('mautic_segment_action', {'objectAction': 'edit', 'objectId': list.id})|e('js') }}');">{{ 'mautic.core.form.edit'|trans }}<i class="ri-edit-line"></i></button>
        {% endif %}
        <button type="button" id="patches-segment-details-page" class="btn btn-secondary" onclick="mQuery('#MauticSharedModal').modal('hide'); Mautic.loadContent('{{ path('mautic_segment_action', {'objectAction': 'view', 'objectId': list.id})|e('js') }}');">{{ 'mautic.core.details'|trans }}<i class="ri-file-list-line"></i></button>
        <button type="button" id="patches-segment-details-close" class="btn btn-tertiary btn-cancel" data-dismiss="modal">{{ 'mautic.core.close'|trans }}<i class="ri-close-line"></i></button>
    </div>
</div>
