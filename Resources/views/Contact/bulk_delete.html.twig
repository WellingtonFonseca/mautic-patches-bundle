{#
  Contact list gear > Excluir em lote: the markup and the texts (data- attributes). Top to bottom: the alert (the count, a failure or the result
  of the last delete), the progress (only while it deletes), the form (the guide text and the contact list table with its own filter bar and
  the red Excluir button). The behavior is Resources/js/contact-bulk-delete.js, injected by ContactBulkDeleteScriptSubscriber: core calls
  Mautic.patchesContactBulkDeleteOnLoad when this page loads (mauticContent patchesContactBulkDelete).
#}
{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}patchesContactBulkDelete{% endblock %}

{% block headerTitle %}{{ 'mautic.patches.contact_bulk_delete.header'|trans }}{% endblock %}

{% block content %}
{# core's .alert sets its own display, which wins over the hidden attribute: a hidden alert would stay on screen #}
<style>#contact-bulk-delete-banner[hidden] { display: none !important; }</style>
<div class="box-layout">
    <div class="col-md-9 bg-auto height-auto bg-white">
        <div class="pa-md" id="contact-bulk-delete"
             data-batch-url="{{ path('mautic_patches_contact_bulk_delete_batch') }}"
             data-table-url="{{ path('mautic_patches_contact_bulk_delete_contacts', {'objectId': 0, 'page': 1}) }}"
             data-found="{{ 'mautic.patches.contact_bulk_delete.found'|trans }}"
             data-found-one="{{ 'mautic.patches.contact_bulk_delete.found_one'|trans }}"
             data-found-none="{{ 'mautic.patches.contact_bulk_delete.found_none'|trans }}"
             data-confirm="{{ 'mautic.patches.contact_bulk_delete.confirm'|trans }}"
             data-confirm-word="{{ 'mautic.patches.contact_bulk_delete.confirm_word'|trans }}"
             data-confirm-type="{{ 'mautic.patches.contact_bulk_delete.confirm_type'|trans({'%word%': 'mautic.patches.contact_bulk_delete.confirm_word'|trans}) }}"
             data-progress="{{ 'mautic.patches.contact_bulk_delete.progress'|trans }}"
             data-done="{{ 'mautic.patches.contact_bulk_delete.done'|trans }}"
             data-error="{{ 'mautic.patches.contact_bulk_delete.error.generic'|trans }}">
            <div id="contact-bulk-delete-banner" role="status" hidden></div>
            <div id="contact-bulk-delete-progress" hidden>
                <div class="alert alert-info"><i class="ri-loader-3-line ri-spin"></i> {{ 'mautic.patches.contact_bulk_delete.deleting'|trans }}</div>
                <div class="progress" style="height: 24px;">
                    <div class="progress-bar progress-bar-danger" id="contact-bulk-delete-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" style="width: 0%; min-width: 3em; line-height: 24px;">0%</div>
                </div>
                <p class="text-muted mt-sm" id="contact-bulk-delete-count"></p>
            </div>
            <div id="contact-bulk-delete-form">
                <div id="contact-bulk-delete-guide" class="mb-md">{{ 'mautic.patches.contact_bulk_delete.guide'|trans }}</div>
                <div class="page-list" id="contact-bulk-delete-result"></div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
