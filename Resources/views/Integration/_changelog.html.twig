{#
  The plugin's change log (Integration::getFormNotes('custom'), drawn under the fields of the first tab of its settings
  screen). Resources/js/plugin-changelog-tab.js moves it into a tab of its own.
  Needs: days (Service/Changelog::days()), a list of {date, items}.
#}

{% if days %}
    <div class="patches-changelog-block" data-tab-label="{{ 'mautic.patches.settings.changelog'|trans }}" data-onload-callback="patchesChangelogTab">
        <h4 class="patches-changelog-title mt-lg mb-sm">{{ 'mautic.patches.settings.changelog'|trans }}</h4>
        <div class="patches-changelog">
            {% for day in days %}
                <div class="patches-changelog__day">
                    <strong>{{ day.date }}</strong>
                    <ul>
                        {% for item in day.items %}
                            <li>{{ item }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}
