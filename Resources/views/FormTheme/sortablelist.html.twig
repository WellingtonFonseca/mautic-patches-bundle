{# Core's sortablelist_row (CoreBundle FormTheme/mautic_form_layout.html.twig: the list of values of a contact or company field, of a form
   field, the parameters of an email or a webhook, ...) with ONE change: the add button comes AFTER the list, where a new value appears, and
   it looks like the "Adicionar critério" one of the campaign condition (btn-tertiary btn-sm, ri-add-line). Core's script
   (Mautic.activateSortable) finds the button by its id (`<id>_additem`), reads its data-prototype and appends to `.list-sortable`, wherever
   the button is. The blocks core's row calls (sortablelist_entry_row, sortablelist_errors) belong to core's own theme, so they are written
   inline. Added to the Twig form themes by DependencyInjection/Compiler/SortableListThemePass, after core's, so this block wins. #}
{% block sortablelist_row %}
    {% set list = form.children.list %}
    {% if form_errors(form.parent) and list.vars.value is empty and form.parent.children.properties.list is defined and form.parent.vars.data.getId() is same as null %}
        {# Work around for Symfony bug not repopulating values only for add action #}
        {% set list = form.parent.children.properties.list %}
    {% endif %}
    {% set feedbackClass = form_errors(list) ? ' has-error' : '' %}
    {% set datePrototype = list.vars.prototype is defined ? ('<div class="sortable">' ~ form_widget(list.vars.prototype|raw) ~ '</div>')|e : '' %}
    {% set errorMessages = [] %}
    {% for error in errors %}
        {% if error.getMessage() not in errorMessages %}
            {% set errorMessages = errorMessages|merge([error.getMessage()]) %}
        {% endif %}
    {% endfor %}
    <div class="row">
        <div data-toggle="sortablelist" data-prefix="{{ form.vars.id }}" class="form-group col-xs-12 {{ feedbackClass }}" id="{{ form.vars.id }}_list" style="overflow:auto">
            {{ form_label(form, label) }}
            {% if errorMessages|length > 0 %}
                <div class="help-block">
                    {% if errorMessages|length > 1 %}
                        <ul>{% for errorMessage in errorMessages %}<li>{{ errorMessage|escape }}</li>{% endfor %}</ul>
                    {% else %}
                        {{ errorMessages|first|escape }}
                    {% endif %}
                </div>
            {% endif %}
            {% if isSortable %}
                <div id="sortable-{{ form.vars.id }}" class="list-sortable" {% for k, v in attr %}{{ '%s="%s" '|format(k|escape, v|escape)|raw }}{% endfor %}>
            {% endif %}
                {% for item in list.children %}
                    <div class="sortable">
                        {{ form_widget(item) }}
                        {{ form_errors(item) }}
                    </div>
                {% endfor %}
            </div>
            {% if isSortable %}
                <input type="hidden" class="sortable-itemcount" id="{{ form.vars.id }}_itemcount" value="{{ list|length }}" />
            {% endif %}
            <a data-prototype="{{ datePrototype|raw }}" class="btn btn-tertiary btn-sm btn-add-item btn-nospin mt-sm" href="#" id="{{ form.vars.id }}_additem">
                <i class="ri-add-line"></i> {{ addValueButton|trans }}
            </a>
        </div>
    </div>
{% endblock %}
