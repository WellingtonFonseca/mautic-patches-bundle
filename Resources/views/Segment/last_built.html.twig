{# Under the name of a segment in the segment list. item = the segment (LeadList), builtText = its last built date written for the user (null if never built). #}
<div class="text-muted mt-4 segment-last-built">
    <small>
        {% if builtText is not null %}
            {{ 'mautic.patches.segment.last_built'|trans({'%date%': builtText}) }}
        {% else %}
            {{ 'mautic.patches.segment.never_built'|trans }}
        {% endif %}
    </small>
</div>
