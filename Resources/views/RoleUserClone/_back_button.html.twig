{# The back button of the pages of the roles / users clone, as core's pages have it (indexButton, above the title). Core's pt_BR text of close_back names its placeholder %alvo%, not %target%: both are given. #}
{% set target = ('mautic.patches.role_user_clone.list.'~kind)|trans %}
{% include '@MauticCore/Helper/button.html.twig' with {
    buttons: [
        {
            label: 'mautic.core.close_back'|trans({'%target%': target, '%alvo%': target}),
            size: 'xs',
            variant: 'tertiary',
            icon: 'ri-arrow-left-line',
            href: path(indexRoute),
            attributes: {
                'data-toggle': 'ajax',
                'class': 'btn-back mb-lg'
            }
        }
    ]
} %}
