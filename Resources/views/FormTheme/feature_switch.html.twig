{#
  One feature of the plugin settings modal (Features tab), the row of Form/Type/FeatureSwitchType: the switch in 5 of the 12 columns, the info alert
  (the `alert` of the field) in the other 7, so a tall alert only pushes the next feature down. Registered as a form theme by
  DependencyInjection/Compiler/FeatureSwitchThemePass.
#}
{% block patches_feature_switch_row %}
<div class="row">
    <div class="col-sm-5">
        {{ form_label(form, label) }}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
    </div>
    <div class="col-sm-7">
        <div class="alert alert-info">{{ alert|trans }}</div>
    </div>
</div>
{% endblock %}
